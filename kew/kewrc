# kew Settings

# IMPORTANT: kew doesn't write to this file, except for when you run kew path.
# Delete this file if you installed a new version of kew and you want to see new settings here.
# kew will then generate the file with all available settings.
# kew tracks all in-app settings changes in kewstaterc, which take precedence over kewrc.

[miscellaneous]

# Path to music library.

path=~/Music

# Enable artist database, that provides clickable artists links in track view.

useArtistsDb=1

# Allow desktop notification on track change.

allowNotifications=1

# Remove leading numbers from track file names, used in library and playlist.

stripTrackNumbers=1

hideLogo=0

hideHelp=0

hideFooter=0

# Hide track time line from track view.

hideTimeStatus=0

# Toggles showing kHz and bitrate.

simpleTimeStatus=1


# Hide cover shown on the left when a song is playing in most views.

hideSideCover=0

# Show only top level folders.

collapseTopLevel=0


# Resume last playing song when starting kew.

autoResume=0

# Toggle animated song title, set to 0 to disable.

titleDelay=1

# Same as '--quitonstop' flag, exits after playing the whole playlist.

quitOnStop=0

# Whether clearing the playlist also removes the currently playing song.

clearListClearsAll=1

# Glimmering text on the bottom row.

hideGlimmeringText=0

# Replay gain check first, can be either 0=track, 1=album, 2=disabled or 3=auto.

replayGainCheckFirst=3

# Save Repeat and Shuffle Settings.

saveRepeatShuffleSettings=0

# Repeat state 0 = off, 1 = repeat track, 2 = repeat list.

repeatState=0

shuffleEnabled=0

# Set the window title to the title of the currently playing track

trackTitleAsWindowTitle=1


[colors]

# Theme's go in ~/.config/kew/themes (on Linux/FreeBSD/Android), 
# and ~/Library/Preferences/kew/themes (on macOS), 

theme=~/.config/kew/themes/catpuccin.theme


# Color Mode is:
# 0 = 16-bit color palette from default theme, 
# 1 = Colors derived from One Album Color Theme, 
# 2 = Colors derived from TrueColor theme, 
# 3 = Colors derived from Album Colors Theme, 

# 4 = Neutral, devoid of color, 

# Color Mode:

colorMode=3

# Terminal color theme is default.theme in 
# ~/.config/kew/themes (on Linux/FreeBSD/Android), 
# and ~/Library/Preferences/kew/themes (on macOS).


[crossfade]


# Crossfade at end of song.

alwaysCrossfade=0


# Fade in on song at a certain track time, in milliseconds.

fadeEnterSongMs=0


# Fade length in milliseconds of quick fade.

fadeQuickMs=3000


# Fade length in milliseconds of medium fade.

fadeMediumMs=5000


# Fade length in milliseconds of slow fade.

fadeSlowMs=10000


[track cover]

coverEnabled=1


# Show covers in ascii (ansi) mode.

coverAnsi=0

# Cover render style: auto, kitty, sixels, block, braille, ascii, dot, vhalf, quad

coverStyle=auto


[mouse]

mouseEnabled=1


[discord]


# Show now playing status in Discord. Note: Reveals your listening habits to discord.

discordRPCEnabled=0


[chroma]


# Path to custom chroma presets.

chromaPath=

# Name of audio device that Chroma should use, for instance Pipewire Server.

chromaDevice=


[visualizer]

# Visualizer mode: 0=lighten, 1=flat, 2=reversed lighten, 3=party, 4=vibrant. 5=lum vibrant 6=binning 7=two color gradient 8=off.

visualizerColorType=3
visualizerHeight=6

# Show visualizer as dots instead of bars.

visualizerBrailleMode=0

# 0=Thin bars, 1=Bars twice the width, 2=Auto (depends on window size).

visualizerBarWidth=2


[progress bar]

# Progress bar in track view
# The progress bar can be configured in many ways.
# When copying the values below, be sure to include values that are empty spaces or things will get messed up.
# Be sure to have the actual uncommented values last.
# For instance use the below values for a pill muncher mode:

#progressBarElapsedEvenChar= 
#progressBarElapsedOddChar= 
#progressBarApproachingEvenChar=•
#progressBarApproachingOddChar=·
#progressBarCurrentEvenChar=ᗧ
#progressBarCurrentOddChar=ᗧ

# To have a thick line: 

#progressBarElapsedEvenChar=━
#progressBarElapsedOddChar=━
#progressBarApproachingEvenChar=━
#progressBarApproachingOddChar=━
#progressBarCurrentEvenChar=━
#progressBarCurrentOddChar=━

# To have dots (the original): 

#progressBarElapsedEvenChar=■
#progressBarElapsedOddChar= 
#progressBarApproachingEvenChar==
#progressBarApproachingOddChar= 
#progressBarCurrentEvenChar=■
#progressBarCurrentOddChar= 

# Current values: 

progressBarElapsedEvenChar=━
progressBarElapsedOddChar=━
progressBarApproachingEvenChar=━
progressBarApproachingOddChar=━
progressBarCurrentEvenChar=━
progressBarCurrentOddChar=━


