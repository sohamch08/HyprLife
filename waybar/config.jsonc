// -*- mode: jsonc -*-
{
  "layer": "bottom",
  "position": "top",
  "height": 10,
  "spacing": 8,
  "margin-top": 8,
  "margin-left": 4,
  "margin-right": 4,
  "reload_style_on_change": true,
  "modules-left": ["clock", "hyprland/workspaces"],
  "modules-center": ["tray"],
  "modules-right": [
    "pulseaudio",
    "network",
    "temperature",
    "backlight",
    "battery",
    "bluetooth",
    "custom/notification",
  ],
  // Modules configuration
  "hyprland/workspaces": {
    "disable-scroll": true,
    "all-outputs": true,
    "warp-on-scroll": false,
    "format": "{icon}",
    "format-icons": {
      "active": "",
      "default": "",
      "empty": "",
      "urgent": "",
    },
    "persistent-workspaces": {
      "*": 5,
    },
  },
  "hyprland/window": {
    "max-length": 40,
    "separate-outputs": false,
  },
  "tray": {
    "icon-size": 21,
    "spacing": 10,
    "show-passive-items": true,
    "icons": {
      "chatgpt": "/home/soham/.config/waybar/assets/chatgpt-tray.svg",
      // nm-applet uses the tray theme's real signal-strength icons.
      "claude": "/home/soham/.config/waybar/assets/tray/claude.svg",
      "Claude": "/home/soham/.config/waybar/assets/tray/claude.svg",
      "Claude_status_icon_1": "/home/soham/.config/waybar/assets/tray/claude.svg",
      // Resolve tray IDs through the installed Papirus alias mappings.
      "zoom": "/home/soham/.local/share/icons/breeze-dark/status/24/us.zoom.Zoom.svg",
      "Zoom": "/home/soham/.local/share/icons/breeze-dark/status/24/us.zoom.Zoom.svg",
      // Steam advertises a private IconThemePath; use the installed alias directly.
      "steam": "/home/soham/.local/share/icons/breeze-dark/status/24/com.valvesoftware.Steam.svg",
      "Steam": "/home/soham/.local/share/icons/breeze-dark/status/24/com.valvesoftware.Steam.svg",
      // OBS supplies themed idle/recording/paused icons from its Flatpak data directory.
      "KDE Connect Indicator": "kdeconnect-tray-symbolic",
      // "blueman": "bluetooth",
      // "TelegramDesktop": "$HOME/.local/share/icons/hicolor/32x32/apps/telegram.svg",
      "spotify": false,
    },
    "orders": {
      "wechat": 99,
    },
  },
  "clock": {
    "format": "{:%H:%M} <span font_family='Material Terminal Rounded' size='16pt' rise='-5120'>\udbd0\udd27</span>",
    "format-alt": "{:%A, %B %d, %Y (%R)} 󰃰 ",
    "tooltip-format": "<tt><small>{calendar}</small></tt>",

    "calendar": {
      "mode": "month",
      "mode-mon-col": 3,
      "weeks-pos": "right",
      "first-day-of-week": 1,
      "on-scroll": 1,
      "on-click-right": "mode",
      "format": {
        "months": "<span color='#ffead3'><b>{}</b></span>",
        "days": "<span color='#ecc6d9'><b>{}</b></span>",
        "weeks": "<span color='#99ffdd'><b>W{}</b></span>",
        "weekdays": "<span color='#ffcc66'><b>{}</b></span>",
        "today": "<span color='#ff6699'><b><u>{}</u></b></span>",
      },
    },
  },
  "temperature": {
    // "thermal-zone": 2,
    // "hwmon-path": "/sys/class/hwmon/hwmon2/temp1_input",
    "critical-threshold": 80,
    "format-critical": "{temperatureC}°C {icon}",
    "format": "{temperatureC}°C {icon}",
    "format-icons": ["", "", "", "", ""],
  },
  "backlight": {
    // "device": "acpi_video1",
    "format": "{percent}% <span font_family='Material Terminal Rounded' size='16pt' rise='-5120'>{icon}</span>",
    "format-icons": ["\udbd3\uddda", "\udbd0\ude4f", "\udbd0\ude50", "\udbd0\ude51", "\udbd0\ude52", "\udbd0\ude53", "\udbd0\ude54", "\udbd0\ude55"],
    "min-brightness": 1,
  },
  "battery": {
    "interval": 30,
    "states": {
      "warning": 30,
      "critical": 15,
    },
    "events": {
      "on-discharging-warning": "notify-send -u normal 'Low Battery'",
      "on-discharging-critical": "notify-send -u critical 'Very Low Battery'",
      "on-charging-100": "notify-send -u normal 'Battery Full!'",
    },
    "on-update": "sh \"$HOME/.config/waybar/scripts/battery-status.sh\"",
    "format": "{capacity}% <span font_family='Material Terminal Rounded' size='16pt' rise='-5120'>{icon}</span>",
    "format-charging": "{capacity}% {icon}",
    "format-icons": {
      "charging": ["󰢜", "󰂆", "󰂇", "󰂈", "󰢝", "󰂉", "󰢞", "󰂊", "󰂋", "󰂃"],
      "default": ["\udbd2\udf36", "\udbd2\udf3c", "\udbd2\udf3b", "\udbd2\udf3a", "\udbd2\udf39", "\udbd2\udf38", "\udbd2\udf37", "\udbd2\udf34"],
    },
    "max-length": 25,
  },
  "network": {
    "interface": "wlo1*", // (Optional) To force the use of this interface
    "format-wifi": "{essid} ({signalStrength}%)  {icon}",
    "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
    "format-ethernet": "{ipaddr}/{cidr} 󰈀",
    "tooltip-format": "{ifname} via {gwaddr} 󰊗",
    "format-linked": "{ifname} (No IP) 󰊗",
    "format-disconnected": "Disconnected ⚠",
    // "format-alt": "{ifname}: {ipaddr}/{cidr}",
    // "on-click": "wifi-manager --toggle",
  },
  "pulseaudio": {
    // "scroll-step": 1, // %, can be a float
    "format": "{volume}% {icon}, {format_source}",
    "format-bluetooth": "{volume}% {icon} , {format_source}",
    "format-bluetooth-muted": "󰅶 {icon} , {format_source}",
    "format-muted": "󰅶 {format_source}",
    "format-source": "{volume}% <span font_family='Material Terminal Rounded' size='16pt' rise='-5120'>\udbd0\udc22</span>",
    "format-source-muted": "<span font_family='Material Terminal Rounded' size='16pt' rise='-5120'>\udbd0\udc24</span>",
    "format-icons": {
      "headphone": "",
      "hands-free": "󰂑",
      "headset": "",
      "phone": "",
      "portable": "",
      "car": "",
      "default": ["", "", ""],
    },
    "on-click": "pavucontrol",
  },
  "custom/notification": {
    "tooltip": true,
    "format": "<span font_family='Material Terminal Rounded' size='16pt'>{icon}</span>",
    "format-icons": {
      "notification": "\udbd3\udd57",
      "none": "\udbd1\udcbe",
      "dnd-notification": "\udbd1\udcc0",
      "dnd-none": "\udbd1\udcc0",
      "inhibited-notification": "\udbd1\udcc0",
      "inhibited-none": "\udbd1\udcc0",
      "dnd-inhibited-notification": "\udbd1\udcc0",
      "dnd-inhibited-none": "\udbd1\udcc0",
    },
    "return-type": "json",
    "exec-if": "which swaync-client",
    "exec": "swaync-client -swb",
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw",
    "escape": true,
  },
  "bluetooth": {
    "on-click": "$HOME/.cargo/bin/blurs",
    "format": "<span font_family='Material Terminal Rounded' size='16pt' rise='-5120'>\udbd0\udd36</span> {status}",
    "format-off": "<span font_family='Material Terminal Rounded' size='16pt' rise='-5120'>\udbd0\udd38</span> dis",
    "format-disabled": "<span font_family='Material Terminal Rounded' size='16pt' rise='-5120'>\udbd0\udd38</span> dis",
    "format-connected": "<span font_family='Material Terminal Rounded' size='16pt' rise='-5120'>\udbd0\udd37</span> {device_alias}",
    "format-connected-battery": "<span font_family='Material Terminal Rounded' size='16pt' rise='-5120'>\udbd0\udd37</span> {device_alias} {device_battery_percentage}%",
    "format-device-preference": ["device1", "device2"],
    "tooltip-format": "{controller_alias}\t{controller_address}\n\n{num_connections} connected",
    "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{num_connections} connected\n\n{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
    "tooltip-format-enumerate-connected-battery": "{device_alias}\t{device_address}\t{device_battery_percentage}%"
  }
}
