{
  "logo": {
    "type": "file",
    "source": "$HOME/.config/fastfetch/ascii-text.txt",
    "padding": { "top": 2, "left": 2 },
    "color": {
      "1": "white",
      "2": "red",
    },
  },
  "display": {
    "key": {
      "width": 15,
    },
    "color": "#cbd5e1",
    "separator": "~>",
  },
  "modules": [
    "break",
    "break",
    "break",
    "break",
    {
      "type": "title",
      "format": "{6}",
      "color": "#e11d48",
    },
    "separator",
    {
      "type": "os",
      "key": "OS       ",
      "keyColor": "#4fd1c5",
      "format": "Arch (Btw)",
    },
    {
      "type": "kernel",
      "key": "Kernel   ",
      "keyColor": "#4fd1c5",
      "format": "{1} {2}",
    },
    {
      "type": "users",
      "key": "User     ",
      "keyColor": "#4fd1c5",
      "format": "Iso",
    },
    "break",
    {
      "type": "uptime",
      "key": "Uptime   ",
      "keyColor": "#4fd1c5",
    },
    {
      "type": "bios",
      "key": "Bios     ",
      "keyColor": "#4fd1c5",
      "format": "{4}",
    },
    {
      "type": "cpu",
      "key": "CPU      ",
      "temp": true,
      "showPeCoreCount": true,
      "keyColor": "#4fd1c5",
      "format": "{1}",
    },
    {
      "type": "gpu",
      "key": "GPU      ",
      "temp": true,
      "showPeCoreCount": true,
      "keyColor": "#4fd1c5",
      "format": "{1} {2} {4}",
    },
    {
      "type": "memory",
      "key": "RAM      ",
      "temp": true,
      "showPeCoreCount": true,
      "keyColor": "#4fd1c5",
      "format": "{1} / {2} {3}",
    },
    "break",
    {
      "type": "Disk",
      "key": "Disk     ",
      "keyColor": "#4fd1c5",
      "format": "{1} / {2} {3} ",
    },
  ],
}
